/**
 * @file Compile LaTeX document
 * @author Milos Petrasinovic <mpetrasinovic@pr-dc.com>
 * PR-DC, Republic of Serbia
 * info@pr-dc.com
 * @version 0.0.1
 */
close('all'); clear; clc;
disp(' --- ' + jsl_file_name + ' ---');

// Choose TeX files
var options = {
  title: 'Choose TeX file',
  buttonLabel: 'Choose TeX file',
  properties: ['multiSelections'],
  filters: [
    {name: 'TeX', extensions: ['tex']},
    {name: 'All Files', extensions: ['*']}
  ]
};

var files = chooseFile(options);
if(typeof files === 'string') files = [files];
if(!Array.isArray(files)) files = [];

tic;
var compiled = 0;
for(var i = 0; i < files.length; i++) {
  var file = files[i];
  disp(' Compiling ' + file + ' (' + (i + 1) + '/' + files.length + ').');
  var result = await compileLatex(file);
  if(result?.ok) {
    compiled++;
    disp(' Saved ' + result.pdf);
  } else if(result?.missing?.length) {
    disp(' Missing TeX tools: ' + result.missing.join(', '));
    disp(' Run openLatexEditor.jsl and click Recompile to configure the toolchain.');
    break;
  } else {
    disp(' Compilation failed.');
    if(result?.log) disp(result.log);
  }
}

disp(' Compiled ' + compiled + ' of ' + files.length + ' document(s).');
disp(' Execution time: ' + num2str(toc(), 2) + ' seconds');
disp(' -------------------- ');
