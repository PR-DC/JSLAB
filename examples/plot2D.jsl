/**
 * @file Simple example for 2D plot
 * @author Milos Petrasinovic <mpetrasinovic@pr-dc.com>
 * PR-DC, Republic of Serbia
 * info@pr-dc.com
 * @version 0.0.1
 */

var figure_size = [560, 420];
var x = linspace(-10, 10, 201);
plot({x: x, y: x.map(Math.sin)});
xlabel("x");
ylabel("sin(x)");
title("Simple 2-D Plot");
var output_dir = pathJoin(getDir(jsl.current_script), 'out');
mkdir(output_dir);
var figure_file = pathJoin(output_dir, removeExtension(jsl_file_name));
await printFigure(figure_file, {type: 'png', size: figure_size});
await printFigure(figure_file, {type: 'pdf', size: figure_size});
