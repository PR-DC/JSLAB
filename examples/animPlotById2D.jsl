/**
 * @file Simple test for 2D plot animation by ID
 * @author Milos Petrasinovic <mpetrasinovic@pr-dc.com>
 * PR-DC, Republic of Serbia
 * info@pr-dc.com
 * @version 0.0.1
 */

var N_buffer = 500;
var start_time = tic;
var t = toc(start_time);
var x = createFilledArray(N_buffer, null); x[0] = t;
var y = createFilledArray(N_buffer, null); y[0] = Math.sin(t);
var p = plot({x: x, y: y, id: 'line'});
xlabel("x");
ylabel("sin(x)");
title("Simple 2-D Plot");

await p.ready;
var plot_timer = setInterval(function() {
  var t1 = toc(start_time);
  x.push(t1);
  y.push(Math.sin(t1*2));
  if(x.length > N_buffer) {
    x.shift();
    y.shift();
  }
  p.updateById({x: x, y: y, id: 'line'});
}, 33);
