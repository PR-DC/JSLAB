/**
 * @file Control module test
 * @author Milos Petrasinovic <mpetrasinovic@pr-dc.com>
 * PR-DC, Republic of Serbia
 * info@pr-dc.com
 * @version 0.0.1
 */
close('all'); clear; clc; tic;
disp(' --- ' + jsl_file_name + ' ---');

var num = [3.953, 1];
var den = [1, 2, 3.868];

var t = range(0, 49); // Time vector
var u = ones(t.length); // Unit step input

// Simulate the system response
var { y } = lsim(tf(num, den), u, t);

// Plot the simulated response and the unit step response.
console.log("Output (y):", y);
var responsePlot = lsimplot(tf(num, den), u, t);
await responsePlot.ready;
figure();
var unitStepPlot = stepplot(ss(-2, 1, 1, 0), 5);
await unitStepPlot.ready;
var plant = tf([1], [1, 2]);
var closedLoop = feedback(plant);
console.log("Closed-loop coefficients:", ss2tf(closedLoop));
figure();
await bodeplot(plant).ready;
figure();
await nyquistplot(plant).ready;
figure();
await pzplot(closedLoop).ready;
console.log("Closed-loop DC gain and stability:", dcgain(closedLoop), isstable(closedLoop));
console.log("Closed-loop controllability and observability:", isctrb(closedLoop), isobsv(closedLoop));
var impulseResponse = impulse(closedLoop, 5);
console.log("Impulse response at t = 0:", impulseResponse.y[0]);
var loopPlant = tf([24], [1, 6, 11, 6]);
console.log("Open-loop gain and phase margins:", margin(loopPlant));
figure();
await rlocusplot(loopPlant).ready;
var piLoop = feedback(series(pid(2, 1), plant));
figure();
await stepplot(piLoop, 5).ready;
var stateMatrix = [[0, 1], [-2, -3]];
var inputMatrix = [[0], [1]];
console.log("Pole-placement gain:", place(stateMatrix, inputMatrix, [-2, -4]));
console.log("LQR design:", lqr(stateMatrix, inputMatrix, [[1, 0], [0, 1]], 1));
var fitTime = linspace(0, 5, 101);
var fitInput = ones(fitTime.length);
var fitOutput = lsim(plant, fitInput, fitTime).y;
console.log("Estimated transfer function:", tfest(fitTime, fitInput, fitOutput, 1, 0));

// Discretize three transfer functions with the same denominator.
var continuousDenominator = [1, 16.52, 155.1, 2];
for(const numerator of [[1.095, 23.03], [1.095, 23.03, 3], [1.095, 23.03, 1, 1]]) {
  const { num: numd, den: dend } = c2d(numerator, continuousDenominator, 1);
  console.log("Discrete-time transfer function:", { numd, dend });
}

// - Kraj proračuna
disp(' Program je uspešno izvršen... ');
disp(' Potrebno vreme: ' + num2str(toc(), 2) + ' sekundi');
disp(' -------------------- ');
